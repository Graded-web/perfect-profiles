{
  // Cloudflare Workers config: serve the built dist/ folder as static assets.
  "name": "perfect-profiles",
  "compatibility_date": "2026-08-01",
  "main": "worker.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "404-page"
  },
  "kv_namespaces": [
    { "binding": "QUOTES", "id": "b30ddb194fcd440d8dde051bb00bb2d6" }
  ]

  // Lead capture (POST /api/quote) storage. Read leads back with:
  //   npx wrangler kv key list --binding QUOTES --remote
  //   npx wrangler kv key get "<key>" --binding QUOTES --remote
}
